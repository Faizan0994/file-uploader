<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up</title>
  </head>
  <body>
    <h1>Create an Account</h1>
    <% if (errors){%>
    <ul>
      <% errors.forEach(error => { %>
      <li><%= error.msg %></li>
      <% }) %>
    </ul>
    <% } %>
    <form action="/auth/signup" method="post">
      <label for="fullname"
        >Full Name:
        <input
          type="text"
          name="fullname"
          id="fullname"
          value="<%= fullname || ''%>"
          required
      /></label>
      <label for="username"
        >Username:
        <input
          type="text"
          name="username"
          id="username"
          value="<%= username || ''%>"
          required
      /></label>
      <label for="password"
        >Password:
        <input
          type="text"
          name="password"
          id="password"
          value="<%= password || ''%>"
          required
      /></label>
      <label for="confirm"
        >Confirm Password:
        <input
          type="text"
          name="confirm"
          id="confirm"
          value="<%= confirm || ''%>"
          required
      /></label>
      <button type="submit">Create Account</button>
    </form>
  </body>
</html>
