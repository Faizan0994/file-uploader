<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/dashboard.css" />
  </head>
  <body>
    <h1>Welcome: <%= name %></h1>
    <a href="/auth/logout"><button>Logout</button></a>
    <div class="files">
      <h2>Files</h2>
      <div class="bar"></div>
      <h3><%= current %></h3>
      <ul>
        <% content[0].forEach(entity => { %>
        <li>
          <div>
            <a href="<%='/users/dashboard/' + entity.path.replace('/', '%2F')%>"
              ><%= entity.name + "/" %></a
            >
            <form
              action="/users/dashboard/<%=entity.path.replace('/', '%2F').replace(' ', '%20')%>/deleteFolder"
              method="post"
            >
              <input
                type="hidden"
                name="currentPath"
                value="<%= current.length > 1 ? current.slice(0, -1).replace('/', '%2F') : 'root' %>"
              />
              <button type="submit">Delete</button>
            </form>
          </div>
        </li>
        <% }) %> <% content[1].forEach(entity => { %>
        <li><%= entity.name %></li>
        <% }) %>
      </ul>
      <a href="/users/upload"><button>Upload A File</button></a>
    </div>
  </body>
</html>
