<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/dashboard.css" />
  </head>
  <body>
    <h1>Welcome: <%= name %></h1>
    <a href="/auth/logout"><button>Logout</button></a>
    <div class="files">
      <h2>Files</h2>
      <div class="bar"></div>
      <h3><%= current %></h3>
      <ul class="content">
        <% content[0].forEach(entity => { %>
        <li>
          <div class="folder">
            <a href="<%='/users/dashboard/' + entity.path.replace('/', '%2F')%>"
              ><%= entity.name + "/" %></a
            >
            <form
              action="/users/dashboard/<%=entity.path.replace('/', '%2F').replace(' ', '%20')%>/deleteFolder"
              method="post"
            >
              <input
                type="hidden"
                name="currentPath"
                value="<%= current.length > 1 ? current.slice(0, -1).replace('/', '%2F') : 'root' %>"
              />
              <button type="submit">Delete</button>
            </form>
            <button
              id="renameFolder"
              data-entity='<%- JSON.stringify(entity).replace(/'/g, "&apos;") %>'
              onclick="renameFolder(this)"
            >
              Rename
            </button>
          </div>
        </li>
        <% }) %> <% content[1].forEach(entity => { %>
        <li class="file"><%= entity.name %></li>
        <% }) %>
      </ul>
      <div class="buttons">
        <button id="createFolder" onclick="createFolder(event)">
          Create folder
        </button>
        <a href="/users/upload" class="uploadButton"
          ><button>Upload A File</button></a
        >
      </div>
    </div>
  </body>
  <script>
    function createFolder(e) {
      const buttons = document.querySelector(".buttons");
      const createFolderButton = e.target;
      const uploadButton = document.querySelector(".uploadButton");
      createFolderButton.classList.add("hidden");
      uploadButton.classList.add("hidden");
      const createFolderForm = document.createElement("form");
      createFolderForm.setAttribute("method", "post");
      createFolderForm.setAttribute(
        "action",
        "/users/dashboard/<%= current === '/' ? 'root' : current.slice(0, -1).replace('/', '%2F').replace(' ', '%20')%>/createFolder"
      );
      const folderNameLabel = document.createElement("label");
      folderNameLabel.setAttribute("for", "folderNameInput");
      folderNameLabel.textContent = "Folder name: ";
      const folderNameInput = document.createElement("input");
      folderNameInput.setAttribute("id", "folderNameInput");
      folderNameInput.setAttribute("name", "folderName");
      folderNameInput.setAttribute("type", "text");

      const submitButton = document.createElement("button");
      submitButton.setAttribute("type", "submit");
      submitButton.textContent = "Create";

      createFolderForm.appendChild(folderNameLabel);
      createFolderForm.appendChild(folderNameInput);
      createFolderForm.appendChild(submitButton);

      buttons.appendChild(createFolderForm);
    }

    function renameFolder(btn) {
      const folder = JSON.parse(btn.dataset.entity);

      const buttons = document.querySelector(".buttons");
      const createFolderButton = document.querySelector("#createFolder");
      const uploadButton = document.querySelector(".uploadButton");
      createFolderButton.classList.add("hidden");
      uploadButton.classList.add("hidden");
      const renameFolderForm = document.createElement("form");
      renameFolderForm.setAttribute("method", "post");
      renameFolderForm.setAttribute(
        "action",
        `/users/dashboard/${folder.path
          .replace("/", "%2F")
          .replace(" ", "%20")}/renameFolder`
      );
      const folderNameLabel = document.createElement("label");
      folderNameLabel.setAttribute("for", "folderNameInput");
      folderNameLabel.textContent = "New name: ";
      const folderNameInput = document.createElement("input");
      folderNameInput.setAttribute("id", "folderNameInput");
      folderNameInput.setAttribute("name", "newName");
      folderNameInput.setAttribute("type", "text");
      const currentPath = document.createElement("input");
      currentPath.setAttribute("type", "hidden");
      currentPath.setAttribute("name", "currentPath");
      currentPath.setAttribute(
        "value",
        "<%= current.length > 1 ? current.slice(0, -1).replace('/', '%2F') : 'root' %>"
      );

      const submitButton = document.createElement("button");
      submitButton.setAttribute("type", "submit");
      submitButton.textContent = "Rename";

      renameFolderForm.appendChild(folderNameLabel);
      renameFolderForm.appendChild(folderNameInput);
      renameFolderForm.appendChild(currentPath);
      renameFolderForm.appendChild(submitButton);

      buttons.appendChild(renameFolderForm);
    }
  </script>
</html>
